[PrefixDeclaration]
:		http://example.org/company#
ex:		http://example.org/company#
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[

mappingId	MAPID-empty-entity
target		:emptyEntity/{id} a :EmptyEntity ;
			:data {data}^^xsd:string .
source		SELECT id, data FROM empty_table

mappingId	MAPID-null-entity
target		:emptyEntity/{id} a :EmptyEntity ;
			:data {data}^^xsd:string .
source		SELECT id, data FROM null_table


]]