[PrefixDeclaration]
:		http://example.org/company#
ex:		http://example.org/company#
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[

mappingId	MAPID-employee-class
target		:employee/{emp_id} a :Employee .
source		SELECT emp_id FROM employees

mappingId	MAPID-manager-subclass
target		:employee/{emp_id} a :Manager .
source		SELECT emp_id FROM employees WHERE emp_type = 'MANAGER'

mappingId	MAPID-engineer-subclass
target		:employee/{emp_id} a :Engineer .
source		SELECT emp_id FROM employees WHERE emp_type = 'ENGINEER'

mappingId	MAPID-sales-subclass
target		:employee/{emp_id} a :SalesPerson .
source		SELECT emp_id FROM employees WHERE emp_type = 'SALES'

]]