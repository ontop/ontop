[PrefixDeclaration]
:		http://example.org/company#
ex:		http://example.org/company#
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[

mappingId	MAPID-employee-basic
target		:employee/{emp_id} a :Employee ;
			:firstName {first_name}^^xsd:string ;
			:lastName {last_name}^^xsd:string ;
			:email {email}^^xsd:string ;
			:hireDate {hire_date}^^xsd:date ;
			:salary {salary}^^xsd:decimal .
source		SELECT emp_id, first_name, last_name, email, hire_date, salary
			FROM employees

mappingId	MAPID-employee-as-person
target		:person/{emp_id} a :Person ;
			:personName {first_name}^^xsd:string .
source		SELECT emp_id, first_name FROM employees

mappingId	MAPID-department-basic
target		:department/{dept_id} a :Department ;
			:departmentName {dept_name}^^xsd:string ;
			:location {location}^^xsd:string ;
			:budget {budget}^^xsd:decimal .
source		SELECT dept_id, dept_name, location, budget
			FROM departments

mappingId	MAPID-works-in-department
target		:employee/{emp_id} :worksInDepartment :department/{dept_id} .
source		SELECT ed.emp_id, ed.dept_id
			FROM employee_dept ed

]]